# ── GhostWire configuration ──────────────────────────────────────────────
# Copiez ce fichier vers .env (ou exportez ces variables) puis éditez.

# Port d'écoute du panneau web GhostWire
GW_PORT=8080

# Interface d'écoute du panneau (0.0.0.0 pour exposer sur le réseau)
GW_HOST=0.0.0.0

# Secret d'admin. Le panneau demande ce token pour les actions sensibles.
# Générez-en un :  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GW_TOKEN=change-me-please

# Chemin des données runtime (clés, configs, état). Par défaut : ./data
GW_DATA_DIR=./data

# Binaire wireproxy à utiliser. Par défaut : ./bin/wireproxy (téléchargé par le CLI)
GW_WIREPROXY=./bin/wireproxy

# Fichier .conf WireGuard à charger (export de votre fournisseur ou généré)
GW_WG_CONFIG=./data/tunnel0.conf

# Mode démo : démarre sans tunnel réel (utile pour tester l'UI)
GW_DEMO=0

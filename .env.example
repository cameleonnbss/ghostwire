# ── GhostWire configuration ──────────────────────────────────────────────
# Copy to .env (or export the variables) and edit.

# Web panel port
GW_PORT=8080

# Panel bind address (0.0.0.0 to expose on the LAN)
GW_HOST=0.0.0.0

# Data directory (accounts, configs, state). Default: ./data
GW_DATA_DIR=./data

# wireproxy binary path. Default: ./bin/wireproxy (fetched by the CLI)
GW_WIREPROXY=./bin/wireproxy

# WireGuard .conf to load (provider export or generated)
GW_WG_CONFIG=./data/tunnel0.conf

# SOCKS5 / HTTP proxy ports used by wireproxy
GW_SOCKS_PORT=1080
GW_HTTP_PORT=8888

# Optional proxy auth as user:pass
#GW_PROXY_AUTH=user:pass

# Demo mode: start without a real tunnel (UI testing)
GW_DEMO=0
#
# Accounts are managed with the CLI, not env vars:
#   node bin/ghostwire.js useradd admin mypassword
